{
    // `dep-lab` and `dep_lab` both template the module name `DepLab`, so one run shipping both
    // would write the name twice (GE003). `absent-lab` is configured and never reached (GE002).
    "groups": {
        "dep-lab": "ship",
        "dep_lab": "ship",
        "absent-lab": "ship"
    }
}
