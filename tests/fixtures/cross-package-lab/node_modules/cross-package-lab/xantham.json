{
    // The dependency is templated rather than resolved: every type it declares is written as
    // the name a `ship` run of `cross-package-dep` produces (O7's `reference`). The corpus
    // ships that run - `golden/cross-package-dep/CrossPackageDep.fs` - so the compile gate is
    // what decides whether the templated name is the shipped one.
    "groups": {
        "cross-package-dep": "reference"
    }
}
