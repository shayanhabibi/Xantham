<Project Sdk="Microsoft.NET.Sdk">

    <!-- The compile gate of docs/plans/generator-architecture.md §5: the committed golden
         bindings are compiled as F# against Fable.Core on every build, because bindings that
         do not compile are not bindings. Growing the golden corpus means adding its .fs files
         here. A Fable compile joins once the support package exists (phase D). -->

    <PropertyGroup>
        <!-- net8.0 rather than netstandard2.0: the ParamObject Create members (D3) are static
             interface members with bodies, which need default-interface-member runtime support
             to type-check. Fable erases them; the gate only proves the F# compiles. -->
        <TargetFramework>net8.0</TargetFramework>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <!-- FS1104, "identifiers containing '@' are reserved for F# code generation": a
             JavaScript property name is not an F# identifier, and `@cf/meta/llama-3` is a real
             key on a real object. The backticked member is the only way to write it. -->
        <NoWarn>$(NoWarn);FS1104</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="BrandIdioms.fs" />
        <!-- Every committed golden, by wildcard rather than by name. The gate's job is to
             compile *all* of them, so a list of them is a list that can only ever be wrong:
             a golden left off the list is a golden silently ungated. Naming them also made
             this a file every parallel branch appended a line to, and so a file every merge
             conflicted in. All of them follow the hand-written file above, which they
             are allowed to reference.

             The two wildcards below are one ordering rule rather than a list: a run that
             ships a group writes it under `groups/` (O7), and the module naming its types
             refers to it, so `groups/` compiles first. F# resolves a reference into an
             earlier file only, and a wildcard's own order is the filesystem's. Every other
             golden is an independent module, so a new fixture needs no line here.

             Both wildcards exclude the open goldens. O7's `reference` disposition renders a
             group's types as names templated into another package's module, so a golden
             generated against it compiles only where the gated corpus also ships that module.
             The corpus is the unit of closure, not the run: `cross-package-lab` is generated
             as a `reference` against `cross-package-dep`, and both halves are gated together,
             which is what makes the F# compiler - rather than a string comparison - the judge
             of whether the templated name is the shipped one. A golden whose templated module
             nothing ships carries the `.open.fs` suffix and stays out; lane T's section of
             docs/plans/generator-wave-five.md records why stub assemblies were refused. The
             corpus carries no such golden today - the exclusion is the policy an open
             configuration would be admitted under. -->
        <!-- Independent compiler-lib profiles define the same module names. The ES5
             ownership profile is compiled in Xantham.Generator.CompilerLibCompileGate. -->
        <Compile Include="..\Xantham.Generator.Tests\golden\**\groups\*.fs"
                 Exclude="..\Xantham.Generator.Tests\golden\**\*.open.fs;..\Xantham.Generator.Tests\golden\compiler-lib-ownership-lab\**\*.fs"
                 Link="golden\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\Xantham.Generator.Tests\golden\**\*.fs"
                 Exclude="..\Xantham.Generator.Tests\golden\**\groups\*.fs;..\Xantham.Generator.Tests\golden\**\*.open.fs;..\Xantham.Generator.Tests\golden\compiler-lib-ownership-lab\**\*.fs"
                 Link="golden\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="DefaultIntersectionConsumer.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Fable.Core" Version="5.2.0" />
        <ProjectReference Include="..\..\src\Xantham.Fable.Core.TS\Xantham.Fable.Core.TS.fsproj" />
        <!-- The support package is gated with the goldens: generated bindings are allowed to
             reference its erased idioms, so the gate has to prove the two compile together. -->
        <ProjectReference Include="..\..\src\Xantham.Fable.Core\Xantham.Fable.Core.fsproj" />
    </ItemGroup>

</Project>
