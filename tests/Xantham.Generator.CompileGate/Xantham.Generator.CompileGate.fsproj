<Project Sdk="Microsoft.NET.Sdk">

    <!-- The compile gate of docs/plans/generator-architecture.md §5: the committed golden
         bindings are compiled as F# against Fable.Core on every build, because bindings that
         do not compile are not bindings. Growing the golden corpus means adding its .fs files
         here. A Fable compile joins once the support package exists (phase D). -->

    <PropertyGroup>
        <!-- net8.0 rather than netstandard2.0: the ParamObject Create members (D3) are static
             interface members with bodies, which need default-interface-member runtime support
             to type-check. Fable erases them; the gate only proves the F# compiles. -->
        <TargetFramework>net8.0</TargetFramework>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <!-- FS1104, "identifiers containing '@' are reserved for F# code generation": a
             JavaScript property name is not an F# identifier, and `@cf/meta/llama-3` is a real
             key on a real object. The backticked member is the only way to write it. -->
        <NoWarn>$(NoWarn);FS1104</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="BrandIdioms.fs" />
        <Compile Include="..\Xantham.Generator.Tests\golden\ansi-regex\AnsiRegex.fs" Link="ansi-regex\AnsiRegex.fs" />
        <Compile Include="..\Xantham.Generator.Tests\golden\lab\PhaseBLab.fs" Link="lab\PhaseBLab.fs" />
        <Compile Include="..\Xantham.Generator.Tests\golden\globals-lab\GlobalsLab.fs" Link="globals-lab\GlobalsLab.fs" />
        <Compile Include="..\Xantham.Generator.Tests\golden\keyof-lab\KeyofLab.fs" Link="keyof-lab\KeyofLab.fs" />
    <Compile Include="..\Xantham.Generator.Tests\golden\brand-lab\BrandLab.fs" Link="brand-lab\BrandLab.fs" />
        <Compile Include="..\Xantham.Generator.Tests\golden\animejs\Animejs.fs" Link="animejs\Animejs.fs" />
        <Compile Include="..\Xantham.Generator.Tests\golden\@cloudflare\workers-types\Cloudflare.WorkersTypes.fs"
                 Link="workers-types\Cloudflare.WorkersTypes.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Fable.Core" Version="5.2.0" />
        <!-- The support package is gated with the goldens: generated bindings are allowed to
             reference its erased idioms, so the gate has to prove the two compile together. -->
        <ProjectReference Include="..\..\src\Xantham.Fable.Core\Xantham.Fable.Core.fsproj" />
    </ItemGroup>

</Project>
