<Project Sdk="Microsoft.NET.Sdk">

    <!-- The compile gate of docs/plans/generator-architecture.md §5: the committed golden
         bindings are compiled as F# against Fable.Core on every build, because bindings that
         do not compile are not bindings. Growing the golden corpus means adding its .fs files
         here. A Fable compile joins once the support package exists (phase D). -->

    <PropertyGroup>
        <!-- net8.0 rather than netstandard2.0: the ParamObject Create members (D3) are static
             interface members with bodies, which need default-interface-member runtime support
             to type-check. Fable erases them; the gate only proves the F# compiles. -->
        <TargetFramework>net8.0</TargetFramework>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <!-- FS1104, "identifiers containing '@' are reserved for F# code generation": a
             JavaScript property name is not an F# identifier, and `@cf/meta/llama-3` is a real
             key on a real object. The backticked member is the only way to write it. -->
        <NoWarn>$(NoWarn);FS1104</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- Generated beside the table it gates: one type abbreviation per entry of
             `BrowserBindings.generated.fs`, so a table that names something the referenced
             `Fable.Browser.*` versions do not have is a build failure here rather than a
             mystery in someone else's generated bindings. Regenerate both together with
             `generate-wire.fsx generate browser`. -->
        <Compile Include="BrowserBindings.fs" />
        <Compile Include="BrandIdioms.fs" />
        <Compile Include="..\Xantham.Generator.Tests\golden\ansi-regex\AnsiRegex.fs" Link="ansi-regex\AnsiRegex.fs" />
        <Compile Include="..\Xantham.Generator.Tests\golden\lab\PhaseBLab.fs" Link="lab\PhaseBLab.fs" />
        <Compile Include="..\Xantham.Generator.Tests\golden\globals-lab\GlobalsLab.fs" Link="globals-lab\GlobalsLab.fs" />
        <Compile Include="..\Xantham.Generator.Tests\golden\keyof-lab\KeyofLab.fs" Link="keyof-lab\KeyofLab.fs" />
        <Compile Include="..\Xantham.Generator.Tests\golden\generics-lab\GenericsLab.fs" Link="generics-lab\GenericsLab.fs" />
    <Compile Include="..\Xantham.Generator.Tests\golden\brand-lab\BrandLab.fs" Link="brand-lab\BrandLab.fs" />
        <Compile Include="..\Xantham.Generator.Tests\golden\lib-lab\LibLab.fs" Link="lib-lab\LibLab.fs" />
    <Compile Include="..\Xantham.Generator.Tests\golden\animejs\Animejs.fs" Link="animejs\Animejs.fs" />
        <Compile Include="..\Xantham.Generator.Tests\golden\@cloudflare\workers-types\Cloudflare.WorkersTypes.fs"
                 Link="workers-types\Cloudflare.WorkersTypes.fs" />
        <Compile Include="..\Xantham.Generator.Tests\golden\solid-js\SolidJs.fs" Link="solid-js\SolidJs.fs" />
        <Compile Include="..\Xantham.Generator.Tests\golden\type-fest\TypeFest.fs" Link="type-fest\TypeFest.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Fable.Core" Version="5.2.0" />
        <!-- The support package is gated with the goldens: generated bindings are allowed to
             reference its erased idioms, so the gate has to prove the two compile together. -->
        <ProjectReference Include="..\..\src\Xantham.Fable.Core\Xantham.Fable.Core.fsproj" />
    </ItemGroup>

    <!-- The `Fable.Browser.*` family, which is what a generated binding's DOM references
         resolve against. The pins are the same ones `tools/browser-gen/generate.fsx` reflects
         over; the two cannot drift, because the generated gate file above is compiled against
         whatever is listed here. Every one is an interface-only assembly Fable erases, which is
         why the set is the whole family rather than a subset; see the script's header. -->
    <ItemGroup>
        <PackageReference Include="Fable.Browser.Blob" Version="1.4.0" />
        <PackageReference Include="Fable.Browser.Css" Version="2.5.0" />
        <PackageReference Include="Fable.Browser.Dom" Version="2.20.0" />
        <PackageReference Include="Fable.Browser.Event" Version="1.7.0" />
        <PackageReference Include="Fable.Browser.EventSource" Version="1.0.0" />
        <PackageReference Include="Fable.Browser.Gamepad" Version="1.3.0" />
        <PackageReference Include="Fable.Browser.Geolocation" Version="1.3.0" />
        <PackageReference Include="Fable.Browser.IndexedDB" Version="2.2.0" />
        <PackageReference Include="Fable.Browser.IntersectionObserver" Version="1.0.0" />
        <PackageReference Include="Fable.Browser.MediaQueryList" Version="1.5.0" />
        <PackageReference Include="Fable.Browser.MediaRecorder" Version="2.2.0" />
        <PackageReference Include="Fable.Browser.MediaStream" Version="3.4.0" />
        <PackageReference Include="Fable.Browser.Navigator" Version="2.5.0" />
        <PackageReference Include="Fable.Browser.Performance" Version="1.3.0" />
        <PackageReference Include="Fable.Browser.ResizeObserver" Version="1.0.0" />
        <PackageReference Include="Fable.Browser.Svg" Version="2.4.0" />
        <PackageReference Include="Fable.Browser.Url" Version="1.4.0" />
        <PackageReference Include="Fable.Browser.WebGL" Version="1.3.0" />
        <PackageReference Include="Fable.Browser.WebRTC" Version="1.6.0" />
        <PackageReference Include="Fable.Browser.WebSocket" Version="1.4.0" />
        <PackageReference Include="Fable.Browser.WebStorage" Version="1.3.0" />
        <PackageReference Include="Fable.Browser.Worker" Version="1.4.0" />
        <PackageReference Include="Fable.Browser.XMLHttpRequest" Version="1.4.0" />
    </ItemGroup>

</Project>
