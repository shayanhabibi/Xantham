<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>xantham</AssemblyName>
        <RootNamespace>Xantham.Cli</RootNamespace>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>xantham</ToolCommandName>
        <PackageId>xantham</PackageId>
        <Version>0.1.0</Version>
        <Authors>Shayan Habibi</Authors>
        <Description>Command line driver for the Xantham TypeScript-to-F# bindings generator.</Description>
        <PackageTags>typescript;fsharp;fable;bindings;codegen;dotnet-tool</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    <AssemblyVersion>0.0.0.0</AssemblyVersion></PropertyGroup>

    <ItemGroup>
        <!-- The schema is emitted from the config record, so it compiles before the command
             that writes it. -->
        <Compile Include="Types.fs" />
        <Compile Include="Spec.fs" />
        <Compile Include="Schema.fs" />
        <Compile Include="Style.fs" />
        <Compile Include="Cli.fs" />
        <Compile Include="Program.fs" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Xantham.Generator\Xantham.Generator.fsproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Fake.JavaScript.Npm" Version="6.1.4" />
      <PackageReference Include="FSharp.SystemCommandLine" Version="2.2.0" />
      <PackageReference Include="Spectre.Console" Version="0.57.2" />
    </ItemGroup>

</Project>
