<Project Sdk="Microsoft.NET.Sdk">

    <!-- The support package of docs/plans/generator-type-mapping.md §5.4: the one
         runtime-less dependency of generated output. Erased keyof idioms, PropertyRecord
         and the proptypekey machinery, revived near-verbatim from the archive per §7.
         It knows nothing about the generator; the generator only emits references to it. -->

    <PropertyGroup>
        <!-- netstandard2.1 is the Fable library convention; net8.0 joins it so the
             net8.0 compile gate can reference the package without a downgrade. -->
        <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Version>0.1.0-alpha.1</Version>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Xantham.Fable.Core</PackageId>
        <Authors>Shayan Habibi</Authors>
        <Description>The support library every Xantham-generated Fable binding opens. Erased F# forms for the TypeScript type-system idioms F# lacks a spelling for: keyof, indexed access, T[keyof T], index-signature objects and nominal brands. Every type erases at runtime and costs nothing in the emitted JavaScript.</Description>
        <PackageTags>fable;fsharp;typescript;bindings;keyof;erased</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Brand.fs"/>
        <Compile Include="Library.fs"/>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <!-- Fable.Core 5+, pinned: the compile gate carries the same pin, because generated
             bindings and the gate agree on one Fable.Core. -->
        <PackageReference Include="Fable.Core" Version="5.2.0" />
    </ItemGroup>

</Project>
