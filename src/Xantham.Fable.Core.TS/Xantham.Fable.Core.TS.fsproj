<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Version>0.1.0-alpha.2</Version>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
        <PackageId>Xantham.Fable.Core.TS</PackageId>
        <Authors>Shayan Habibi</Authors>
        <Description>Fable bindings for TypeScript's standard-library declarations, generated by Xantham.</Description>
        <PackageTags>fable;fsharp;typescript;bindings;generated</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <NoWarn>$(NoWarn);FS3370;FS0064;FS1182</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Fable.Core.TS.fs" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Xantham.Fable.Core\Xantham.Fable.Core.fsproj" />
        <PackageReference Include="Fable.Core" Version="5.2.0" />
    </ItemGroup>

</Project>
