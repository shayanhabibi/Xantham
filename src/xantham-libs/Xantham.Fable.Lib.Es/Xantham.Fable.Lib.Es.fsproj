<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
        <Version>0.1.0-alpha.1</Version>
        <PackageId>Xantham.Fable.Lib.Es</PackageId>
        <Authors>Shayan Habibi</Authors>
        <Description>Fable binding for the TypeScript compiler lib, generated by Xantham.</Description>
        <PackageTags>fable;fsharp;typescript;bindings</PackageTags>
        <NoWarn>$(NoWarn);FS3370;FS0064;FS1182</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="TypeScript.Lib.fs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Fable.Core" Version="5.2.0" />
        <ProjectReference Include="..\..\Xantham.Fable.Core\Xantham.Fable.Core.fsproj" />
        <ProjectReference Include="../Xantham.Fable.Lib.Dom/Xantham.Fable.Lib.Dom.fsproj" />
    </ItemGroup>
</Project>
