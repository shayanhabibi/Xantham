<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Version>0.1.1</Version>
        <FSharpCoreImplicitPackageVersion>4.7.2</FSharpCoreImplicitPackageVersion>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
        <PackageId>Xantham.Fable.Node</PackageId>
        <Authors>Shayan Habibi</Authors>
        <Description>Fable bindings for node type declarations, generated by Xantham.</Description>
        <PackageTags>fable-javascript;fsharp;typescript;bindings;generated</PackageTags>
        <FablePackageType>binding</FablePackageType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <NoWarn>$(NoWarn);FS3370;FS0064;FS1182</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Node.fs" />
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="xantham.json" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Xantham.Fable.Core.TS\Xantham.Fable.Core.TS.fsproj" />
        <ProjectReference Include="..\Xantham.Fable.Core\Xantham.Fable.Core.fsproj" />
        <PackageReference Include="Fable.Core" Version="5.2.0" />
        <PackageReference Include="Fable.Package.SDK" Version="1.4.1" PrivateAssets="all" />
    </ItemGroup>

</Project>
